rules_version = '2';
// Project RELIQUARY database rules. Paste into Firebase console > Firestore Database > Rules (replacing everything there),
// then Publish. The administrator e-mail must match adminEmail in assets/cloud-config.js (lower case).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'bretomeya@gmail.com';
    }
    // Articles and the starmap: everyone can read, only the administrator can change them.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Chat: everyone can read it live; only the administrator can post or clear it.
    match /chat/{message} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
    }
    // Commanders online: one record per browser. Several people can be logged into the same command at once.
    match /sessions/{browser} {
      allow read: if true;
      allow create, update: if browser.size() <= 20
        && request.resource.data.keys().hasOnly(['command', 'at'])
        && request.resource.data.command in ['', 'eisdon', 'gallia', 'secara', 'histannia', 'harron']
        && request.resource.data.at == request.time;
    }
    // Member accounts: username + PIN sign-up. Usernames and profiles are public; only the administrator deletes them.
    function isMember() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_-]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/banned/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.name.lower() == name;
      allow delete: if isAdmin();
    }
    function validDisplay(d) {
      return d is string && d.matches("^[A-Za-z0-9 _.'-]{2,30}$");
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'display', 'created'])
        && request.resource.data.name is string && request.resource.data.name.matches('^[A-Za-z0-9_-]{3,20}$')
        && validDisplay(request.resource.data.display)
        && request.resource.data.created == request.time
        && !exists(/databases/$(database)/documents/banned/$(uid))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.name.lower())).data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display'])
        && validDisplay(request.resource.data.display);
      allow delete: if isAdmin();
    }
    // Members online: each signed-in member writes their own heartbeat under their display name.
    match /online/{uid} {
      allow read: if true;
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.display
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    match /banned/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isAdmin();
    }
    // Message board: everyone can read. Posts go in a board (old posts without one count as General); only the
    // administrator starts topics in Rules & Getting Started. Members post under their display name, the administrator
    // as Administrator, or either as one of their own characters (the post then carries the character's name).
    // Members can delete their own posts; the administrator can delete any.
    function validAuthor(d) {
      return (d.get('char', '') == ''
          && (isAdmin() || (isMember() && d.from == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.display)))
        || (d.get('char', '') != '' && d.char is string && d.char.size() <= 40
          && get(/databases/$(database)/documents/characters/$(d.char)).data.owner == request.auth.uid
          && d.from == get(/databases/$(database)/documents/characters/$(d.char)).data.name);
    }
    match /board/{post} {
      allow read: if true;
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly(['uid', 'board', 'topic', 'title', 'text', 'from', 'player', 'char', 'faction', 'at'])
        && request.auth != null && request.resource.data.uid == request.auth.uid
        && validAuthor(request.resource.data)
        && request.resource.data.get('board', 'general') is string && request.resource.data.get('board', 'general').matches('^[a-z0-9-]{1,30}$')
        && (request.resource.data.topic != '' || request.resource.data.get('board', 'general') != 'rules' || isAdmin())
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 40
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.from is string && request.resource.data.from.size() <= 130
        && request.resource.data.get('player', '') is string && request.resource.data.get('player', '').size() <= 60
        && request.resource.data.faction is string && request.resource.data.faction.size() <= 20
        && request.resource.data.at == request.time;
    }
    // Forum characters: ids are {uid}_1 to {uid}_10, which limits each signed-in user to ten. Everyone can read them;
    // the owner creates, edits and deletes them; the administrator can delete any.
    function shortText(t) {
      return t is string && t.size() <= 60;
    }
    function validCharacter(d) {
      return d.keys().hasOnly(['owner', 'player', 'name', 'names', 'dob', 'birthplace', 'gender', 'height', 'weight',
          'nationality', 'race', 'occupation', 'affiliation', 'background', 'image', 'updated'])
        && d.owner == request.auth.uid && shortText(d.player)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 130
        && d.names is list && d.names.size() >= 1 && d.names.size() <= 4
        && shortText(d.dob) && shortText(d.birthplace) && shortText(d.gender) && shortText(d.height) && shortText(d.weight)
        && shortText(d.nationality) && shortText(d.race) && shortText(d.occupation) && shortText(d.affiliation)
        && d.background is string && d.background.size() <= 8000
        && d.image is string && d.image.size() <= 200000
        && (d.image == '' || d.image.matches('(https://|data:image/(jpeg|png|webp);base64,).+'))
        && d.updated == request.time;
    }
    match /characters/{id} {
      allow read: if true;
      allow create: if request.auth != null && (isMember() || isAdmin())
        && id.matches('^' + request.auth.uid + '_([1-9]|10)$')
        && !exists(/databases/$(database)/documents/banned/$(request.auth.uid))
        && validCharacter(request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && id.matches('^' + request.auth.uid + '_([1-9]|10)$')
        && validCharacter(request.resource.data);
      allow delete: if isAdmin() || (request.auth != null && resource.data.owner == request.auth.uid);
    }
    // Private messages between members (the administrator can send as Administrator). Only the sender and the recipient
    // can read a message; only the recipient can mark it read. The recipient must be a member.
    match /messages/{msg} {
      allow read: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'text', 'at', 'read'])
        && request.resource.data.from == request.auth.uid
        && !exists(/databases/$(database)/documents/banned/$(request.auth.uid))
        && ((isAdmin() && request.resource.data.fromName == 'Administrator')
          || (isMember() && request.resource.data.fromName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.display))
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.toName == get(/databases/$(database)/documents/users/$(request.resource.data.to)).data.display
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time && request.resource.data.read == false;
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    // Fleets (ids like gallia-2): anyone logged into a command can place and move its fleets; only the administrator changes the ship count (3 to 10).
    match /fleets/{fleet} {
      allow read: if true;
      allow create: if validFleet(fleet) && (isAdmin() || request.resource.data.ships == 5);
      allow update: if validFleet(fleet) && (isAdmin() || request.resource.data.ships == resource.data.ships);
    }
    function validFleet(fleet) {
      let d = request.resource.data;
      return fleet.matches('^(eisdon|gallia|secara|histannia|harron)-[1-9]$')
        && d.keys().hasOnly(['ships', 'at', 'to', 'depart', 'arrive', 'route'])
        && d.ships is int && d.ships >= 3 && d.ships <= 10
        && d.at is string && d.at.size() <= 40 && d.to is string && d.to.size() <= 40
        && d.depart is int && d.arrive is int && d.arrive - d.depart <= 5000000
        && (!('route' in d) || (d.route is list && d.route.size() <= 40));
    }
  }
}
